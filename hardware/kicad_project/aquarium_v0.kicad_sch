	)
	(text "ESP32-C3 SuperMini plugs onto J6. GPIO0-3 -> 1k -> CTRL_x; 100k pull-downs keep LEDs off during boot."
		(exclude_from_sim no)
		(at 1000 6300 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2e853652-83c4-446e-b5d9-1e91380c2dfb")
	)
	(text "LED DRIVER CHANNELS (7x AL8860WT-7, TSOT-25), DUAL RAIL (2026-09-14 audit fix): White = Rail A +24V (duty ~73%); Red/Blue/660nm = Rail B +12V via U10 (t_ON >= 500ns on all channels). High-side sense: rail -> RSET -> SET = string anode; cathode -> L -> SW; D freewheels SW -> rail. I_LED = 0.1V / RSET."
		(exclude_from_sim no)
		(at 4200 1700 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3e9b8f9e-cf54-434a-b025-b31ee214053b")
	)
	(text "AL8860 RESOLVED 2026-09-08: 'AL8860W6-7 SOT-23-6' DOES NOT EXIST (LCSC C460356 = AP3012 boost, wrong part). Use AL8860WT-7 TSOT-25, LCSC C125330. Pinout per DS39014: 1=SW 2=GND 3=CTRL 4=SET 5=VIN."
		(exclude_from_sim no)
		(at 1000 11500 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "500559fa-4728-4825-9e6b-69214d56e20f")
	)
	(text "BOARD JOINTS (2026-09-10): the 580x20 strip is SPLIT into 4 boards (B1 logic+U1+J2 | B2 U5+U6+U2+J3 | B3 U3+J4 | B4 U7+U4+J5). Each seam = 2 pin headers joined off-board by a jumper harness. Pin maps are identical at both ends of each seam; seam 1 uses 1x12, seams 2-3 use 1x10 (CTRL_B/CTRL_R terminate on B2; NC pins = no wire in the harness)."
		(exclude_from_sim no)
		(at 1000 9500 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a2892493-c34d-4785-9b67-000461a29287")
	)
	(text "MCPCB HEADERS: J2-J5 -> LED boards. Red chain J2>J3>J4>J5, blue J2>J3, deep-red J4>J5 (series joins on this PCB)."
		(exclude_from_sim no)
		(at 4200 6700 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ea2f4c4e-0f70-467b-9850-33c864a34787")
	)
	(text "POWER INPUT: J1 (panel jack leads) -> F1 2A slow-blow -> J7 (panel switch loop) -> +24V bus"
		(exclude_from_sim no)
		(at 1000 1900 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "fa73700a-1260-48cc-80ad-08b92f1547c0")
	)
